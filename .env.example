# Copie este arquivo para .env e preencha os valores locais.
# O arquivo .env não deve ser enviado ao GitHub.

POSTGRES_PASSWORD=VIImpact_StrongPassword_2026!
POSTGRES_USER=viimpact
POSTGRES_DB=VIImpactDb
TWELVE_DATA_API_KEY=COLE_SUA_CHAVE_AQUI

# Portas publicadas no Windows
POSTGRES_PORT=5432
API_PORT=5170
WEB_PORT=5173

# Origens autorizadas pela API, separadas por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Configurações opcionais
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
STOCK_COLLECTION_ENABLED=true
STOCK_SYMBOL=TTWO
STOCK_INTERVAL_MINUTES=5

# Deixe vazio para o frontend usar o proxy do Nginx/Vite.
VITE_API_BASE_URL=
