# Copy this file to .env and fill in the required local values.
# The .env file must never be committed.

# Required local secrets
POSTGRES_PASSWORD=
TWELVE_DATA_API_KEY=

# PostgreSQL
POSTGRES_USER=viimpact
POSTGRES_DB=VIImpactDb
POSTGRES_PORT=5432

# Local services
API_PORT=5170
WEB_PORT=5173

# API CORS allowlist. Use comma-separated origins when more than one is needed.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Twelve Data provider
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
TWELVE_DATA_REQUEST_TIMEOUT_SECONDS=10
TWELVE_DATA_MAX_RETRY_ATTEMPTS=2
TWELVE_DATA_RETRY_BASE_DELAY_MILLISECONDS=400
TWELVE_DATA_MAXIMUM_RETRY_DELAY_SECONDS=5
TWELVE_DATA_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
TWELVE_DATA_CIRCUIT_BREAKER_DURATION_SECONDS=30

# Automatic stock collection
STOCK_COLLECTION_ENABLED=true
STOCK_SYMBOL=TTWO
STOCK_INTERVAL_MINUTES=5

# Leave empty to use the local Nginx/Vite proxy.
VITE_API_BASE_URL=
